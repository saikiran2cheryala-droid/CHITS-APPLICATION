# ==============================================================
# CHIT MANAGER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection URL (Supabase, Neon, Railway, Render, Cloud SQL, RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/chit_manager?sslmode=prefer

# Allowed CORS Origins (comma-separated list of allowed frontend domains or * for any)
# Example: https://chit-manager.vercel.app,https://mychitapp.com
CORS_ORIGIN=*

# Frontend API Target (Only needed when frontend is hosted separately from backend)
# Example: https://chit-manager-api.onrender.com
VITE_API_BASE_URL=

# App URL (Public domain of the application)
APP_URL=http://localhost:3000

# SMTP Email Configuration (Optional - for real password recovery emails)
# Compatible with Gmail, SendGrid, Amazon SES, Resend, Brevo, or custom SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SAIKIRAN CHITS" <noreply@saikiranchits.com>
SMTP_SECURE=false

# Resend API Key (Alternative to SMTP)
RESEND_API_KEY=
